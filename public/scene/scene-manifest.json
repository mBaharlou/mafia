   "player_h multiplier",
   "ring rx multiplier",
   "ring ry multiplier"
  ]
 },
 "ids_note": "Character ids are final and identical to the MAFIA-4 pack folders: vinil, pelus, goz, rakun, fitil, murekkep, penguen, teneke.",
 "scene_selection": {
  "pool": "all scenes with status \"active\" (now: meydan, cember)",
  "who_picks": "server, once, at game start (uniform random over the pool; optional weights field later)",
  "broadcast": "the server sends scene_id in the game-start / room-state payload; every client renders that id, so all players see the same scene; reconnecting clients get it from the room state",
  "preload": "during the lobby, clients preload BOTH active scenes (night+day for their layout, about 0.6 MB webp per scene on phone) plus all character sprites, so the reveal has no pop-in",
  "fallback": "unknown scene_id → meydan",
  "adding_a_scene": "add an entry under scenes with id, bg (night+day x desktop+phone), desktop/phone layout params, status. Paid or seasonal scenes later add tier:\"paid\" and an entitlement key; the pool filter then decides who sees it (room host entitlement)."
 },
 "cosmetic_stack": {
  "order_bottom_to_top": [
   "base",
   "costume",
   "hat",
   "effect",
   "flag"
  ],
  "rule": "Cosmetic only, never gameplay. No cosmetic may change hitboxes, sizes, name readability, role hints or state signals (speaking, dead, you).",
  "slots": {
   "base": "the character sprite (idle/speaking/dead)",
   "costume": "future overlay sprite, same 768x1024 canvas and ground line",
   "hat": "future overlay, anchored at head_top per state",
   "effect": "future particle/aura layer, behind or above the sprite, never covering the name flag",
   "flag": "the name flag above the head; every player always has one (default skin standart)"
  }
 },
 "flag_skins": {
  "schema": {
   "id": "string, unique, lowercase ascii",
   "name": "display name (TR)",
   "tier": "free | paid",
   "price": "null for now (pricing is a product decision)",
   "label": "store badge text",
   "cloth": {
    "fill": "[top,bottom] hex gradient stops (solid = same twice)",
    "pattern": "none | velvet | stars | pinstripe (CSS/SVG overlay, never contains text)",
    "edge": "vnotch | swallowtail | straight | fringe",
    "edge_color": "hex or null",
    "accent_stripe": "\"character\" (player accent) | hex | null",
    "image": "optional cloth texture (webp, 9-slice) instead of fill; text still live",
    "nine_slice": "[top,right,bottom,left] px insets when image is used"
   },
   "rod": {
    "fill": "[top,bottom] hex",
    "knob": "none | ball | star (assets/flags/knobs/*.svg)"
   },
   "pole": {
    "fill": "[top,bottom] hex"
   },
   "ornament": "null | svg name in assets/flags/ornaments/ (sits on top of the rod, max 1.35em tall, max 2.2em wide)",
   "text": {
    "color": "hex, rendered as LIVE TEXT (the player name is never baked into art)",
    "weight": "700 fixed"
   },
   "states": {
    "speaking": "{cloth:[a,b], text, glow}",
    "dead": "{cloth:[a,b], text} (strikethrough, torn edge, 7deg tilt and grey parts are applied by the system, not the skin)",
    "you": "{border, text, tab_bg, tab_text}"
   },
   "contrast": "computed WCAG ratio, worst case vs every cloth stop, per state",
   "passes_aa": "must be true (>= 4.5:1 for every state) or the skin is rejected by the build check"
  },
  "locked_by_system": [
   "font family/size",
   "name length/ellipsis rule",
   "position and collision pass",
   "speaking sound icon + glow",
   "dead strikethrough, torn edge, tilt, greyed parts",
   "SEN / ★ tab for the local player"
  ],
  "parts_order": [
   "pole",
   "rod (+knobs)",
   "cloth (+pattern, edge, fringe)",
   "ornament",
   "live text (tab, sound icon, name)"
